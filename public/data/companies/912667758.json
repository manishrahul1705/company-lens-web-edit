eprodukter basert på naturlige/spiselige råvarer. Selskapet vil dessuten avholde kurs i tradisjonsbasert matlaging, selge oppskrifter og utstyr som egner seg til formålet, og blogge om virksomheten. Selskapet vil også eie utsalgssteder med vekt på produkter i kategoriene nevnt ovenfor.","source_name":"Brønnøysund Enhetsregisteret","source_url":"https://data.brreg.no/enhetsregisteret/api/enheter/lastned/csv","retrieved_at":"2026-11-07T09:42:00.798628Z","reporting_period":null,"excerpt":"o,overordnetEnhet,maalform,vedtektsdato,vedtektsfestetFormaal,aktivitet,paategninger,underUtenlandskInsolvensbehandlingDato,underRekonstruksjonsforhandlingDato,fravalgRevisjonDato,fravalgRevisjonBeslutningsDato,erIKonsern,kapital.belop,kapital.antallAksjer,kapital.type,kapital.bundet,kapital.valuta,","evidence_sha256":"e9d4034b5be426ca2017fbb1c9a14f8a8cc12cc8ea758d9eac8fcf713e0ff2a9","claim_id":"ee19203146a5208b281963996960ba8b3882ad187ded8df7c81fe4f70ae17d29","checked_at":"2026-11-07T09:42:00.798628Z"},{"org_number":"912667758","category":"identity","field":"snapshot.analyst.organisation_number","value":"\"912667758\"","claim_id":"f6e4da93446bc7c9c5d21aa58040ab5d7892b81d592a75a651d2c843a9ac9b3e","source_name":"Run metadata","source_url":null,"excerpt":"\"912667758\""},{"org_number":"912667758","category":"identity","field":"0","value":"{\"role_type\": {\"_links\": {\"self\": {\"href\": \"https://data.brreg.no/enhetsregisteret/api/roller/rolletyper/DAGL\"}}, \"beskrivelse\": \"Daglig leder\", \"kode\": \"DAGL\"}, \"name\": \"May Tone Johnsen\", \"entity_organisation_number\": null, \"inactive\": false, \"group_type\": {\"_links\": {\"self\": {\"href\": \"https://data.brreg.no/enhetsregisteret/api/roller/rollegruppetyper/DAGL\"}}, \"beskrivelse\": \"Daglig leder\", \"kode\": \"DAGL\"}, \"last_changed\": \"2019-02-12\", \"from_date\": null}","source_name":"Brønnøysund Enhetsregisteret","source_url":"https://data.brreg.no/enhetsregisteret/api/enheter/912667758/roller","retrieved_at":"202